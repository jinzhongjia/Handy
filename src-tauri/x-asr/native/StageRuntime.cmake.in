set(runtime [==[@HANDY_XASR_RUNTIME_DIR@]==])
set(ort [==[@ort_runtime@]==])
set(system "@CMAKE_SYSTEM_NAME@")
file(MAKE_DIRECTORY "${runtime}")
function(run_checked)
  execute_process(COMMAND ${ARGV} RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE error)
  if(NOT status EQUAL 0)
    message(FATAL_ERROR "Native runtime staging failed: ${ARGV}\n${output}\n${error}")
  endif()
endfunction()

if(system STREQUAL "Darwin")
  file(COPY_FILE "${WRAPPER}" "${runtime}/libhandy_xasr.dylib" ONLY_IF_DIFFERENT)
  file(COPY_FILE "${ort}" "${runtime}/libonnxruntime.dylib" ONLY_IF_DIFFERENT)
  execute_process(COMMAND otool -D "${ort}" RESULT_VARIABLE status OUTPUT_VARIABLE id)
  if(NOT status EQUAL 0)
    message(FATAL_ERROR "Cannot inspect the supplied ONNX Runtime install name")
  endif()
  string(REGEX REPLACE "^[^\n]*\n[ \t]*([^\n]+).*" "\\1" id "${id}")
  string(STRIP "${id}" id)
  run_checked("@CMAKE_INSTALL_NAME_TOOL@" -id "@rpath/libonnxruntime.dylib" "${runtime}/libonnxruntime.dylib")
  run_checked("@CMAKE_INSTALL_NAME_TOOL@" -id "@rpath/libhandy_xasr.dylib"
    -change "${id}" "@rpath/libonnxruntime.dylib" "${runtime}/libhandy_xasr.dylib")
  # install_name_tool invalidates existing signatures, including ad-hoc ARM ones.
  run_checked(codesign --force --sign - "${runtime}/libonnxruntime.dylib")
  run_checked(codesign --force --sign - "${runtime}/libhandy_xasr.dylib")
elseif(system STREQUAL "Windows")
  file(COPY_FILE "${WRAPPER}" "${runtime}/handy_xasr.dll" ONLY_IF_DIFFERENT)
  file(COPY_FILE "${IMPORT_LIBRARY}" "${runtime}/handy_xasr.lib" ONLY_IF_DIFFERENT)
  file(COPY_FILE "${ort}" "${runtime}/onnxruntime.dll" ONLY_IF_DIFFERENT)
elseif(system STREQUAL "Linux")
  file(COPY_FILE "${WRAPPER}" "${runtime}/libhandy_xasr.so" ONLY_IF_DIFFERENT)
  file(COPY_FILE "${ort}" "${runtime}/libonnxruntime.so.1" ONLY_IF_DIFFERENT)
  execute_process(COMMAND "@HANDY_PATCHELF@" --print-needed "${runtime}/libhandy_xasr.so"
    RESULT_VARIABLE status OUTPUT_VARIABLE needed)
  if(NOT status EQUAL 0)
    message(FATAL_ERROR "Cannot inspect native wrapper's runtime dependencies")
  endif()
  string(REPLACE "\n" ";" needed "${needed}")
  foreach(library IN LISTS needed)
    if(library MATCHES "(^|/)libonnxruntime\\.so")
      run_checked("@HANDY_PATCHELF@" --replace-needed "${library}" "libonnxruntime.so.1" "${runtime}/libhandy_xasr.so")
    endif()
  endforeach()
  run_checked("@HANDY_PATCHELF@" --set-soname libonnxruntime.so.1 "${runtime}/libonnxruntime.so.1")
  run_checked("@HANDY_PATCHELF@" --set-rpath "$ORIGIN" "${runtime}/libhandy_xasr.so")
else()
  message(FATAL_ERROR "Unsupported native runtime staging system: ${system}")
endif()
